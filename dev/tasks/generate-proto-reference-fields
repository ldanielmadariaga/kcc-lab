#
# Emits the proto field names that carry (google.api.resource_reference), for
# use as a high-precision ref signal in tests/apichecks.
#
# Services that are not GCP infrastructure are excluded: KCC does not manage
# Google Ads campaigns or Merchant Center accounts, and their field names would
# add noise without adding coverage.

set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

GOOGLEAPIS_DIR="${GOOGLEAPIS_DIR:-.build/third_party/googleapis}"
OUT="tests/apichecks/testdata/proto_reference_fields.txt"

if [[ ! -d "${GOOGLEAPIS_DIR}" ]]; then
  echo "googleapis checkout not found at ${GOOGLEAPIS_DIR}" >&2
  echo "set GOOGLEAPIS_DIR, or run apis/<service>/generate.sh once to populate it" >&2
  exit 1
fi

python3 - "${GOOGLEAPIS_DIR}" "${OUT}" <<'PY'
import os, re, sys

googleapis_dir, out_path = sys.argv[1], sys.argv[2]

# Not GCP infrastructure; see docs/ai/greenfield-tracker.md on scope policy.
EXCLUDE = ("googleads", "searchads360", "merchantapi", "analyticsadmin",
           "admanager", "admob", "shopping", "playdeveloperreporting")

names = set()
for root, _, files in os.walk(googleapis_dir):
    if any(x in root for x in EXCLUDE):
        continue
    for f in files:
        if not f.endswith(".proto"):
            continue
        content = open(os.path.join(root, f), "r", errors="ignore").read()
        for m in re.finditer(r'(?:optional |repeated )?string (\w+) = \d+\s*\[([^\]]*)\]', content, re.S):
            if 'resource_reference' in m.group(2):
                names.add(m.group(1))

with open(out_path, "w") as fh:
    fh.write("# Proto field names carrying (google.api.resource_reference).\n")
    fh.write("#\n")
    fh.write("# Generated by dev/tasks/generate-proto-reference-fields. DO NOT EDIT.\n")
    fh.write("#\n")
    fh.write("# Used by TestMissingRefs as a high-precision signal that a field is a\n")
    fh.write("# reference. Matching is by field name, since a CRD does not record which\n")
    fh.write("# proto field it came from. Non-infrastructure services are excluded.\n")
    fh.write("#\n")
    for n in sorted(names):
        fh.write(n + "\n")

print(f"wrote {len(names)} field names to {out_path}")
PY
