#!/usr/bin/env bash
# Regenerate the greenfield corpus end to end, and re-seed the judgement queue.
#
# The last step is the point of this script. Regeneration rewrites every
# apis/<service>/needs_judgement_call.txt from scratch, which silently discards
# the hints scripts/queue-hints wrote. That has now cost two runs: the original
# bulk generation never ran the seeder at all, and the run after it wiped 367
# hints and reported flagged collapsing from 321 to 77 before anyone noticed.
# Running the two by hand in the right order is not something to rely on.
#
# The CRD half is also not a single command. generate.sh calls
# dev/tasks/generate-crds, which runs controller-gen over ./... and fails
# wholesale the moment one package will not load -- and in this tree 43 do not,
# by design. So CRDs are skipped during generation and rebuilt per service here.
#
# Usage: dev/tasks/greenfield-regenerate [resources.tsv]
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"
RESOURCES="${1:-docs/ai/experiments/data-greenfield/inscope.tsv}"
CG="sigs.k8s.io/controller-tools/cmd/controller-gen@v0.16.5"

echo "== 1/5  wiping types files"
wiped=0
while IFS=$'\t' read -r kind svc types crd; do
  [ -n "${types:-}" ] && [ -f "$types" ] && { rm -f "$types"; wiped=$((wiped+1)); }
done < "${RESOURCES}"
echo "   removed ${wiped} types files (--prepopulate-spec skips one that exists)"

echo "== 2/5  running each service's generate.sh"
cut -f2 "${RESOURCES}" | sort -u > /tmp/gf_services.txt
ok=0; fail=0
while read -r svc; do
  [ -x "apis/$svc/generate.sh" ] || continue
  if SKIP_GENERATE_CRDS=1 timeout 900 "apis/$svc/generate.sh" >"/tmp/gf_gen_$svc.log" 2>&1; then
    ok=$((ok+1))
  else
    fail=$((fail+1)); echo "   FAIL $svc: $(tail -2 "/tmp/gf_gen_$svc.log" | head -1 | cut -c1-100)"
  fi
done < /tmp/gf_services.txt
echo "   services ok=${ok} failed=${fail}"

echo "== 3/5  controller-gen per service"
cgok=0; cgfail=0
while read -r svc; do
  [ -d "apis/$svc" ] || continue
  if (cd apis && timeout 300 go run "${CG}" \
        object:headerFile=../hack/boilerplate.go.txt \
        crd:crdVersions=v1,allowDangerousTypes=true,ignoreUnexportedFields=true \
        output:crd:artifacts:config=config/crd/ paths="./$svc/..." ) >"/tmp/gf_cg_$svc.log" 2>&1; then
    cgok=$((cgok+1))
  else
    cgfail=$((cgfail+1))
  fi
done < /tmp/gf_services.txt
echo "   controller-gen ok=${cgok} failed=${cgfail}"

echo "== 4/5  CRD post-processing and publish"
go run ./scripts/add-validation-to-crds --dir apis/config/crd/ >/dev/null 2>&1
for t in "set-field spec.preserveUnknownFields=false" "delete-field status" \
         "set-annotation cnrm.cloud.google.com/version=0.0.0-dev" \
         "delete-annotation controller-gen.kubebuilder.io/version" \
         "reflow-descriptions" "backport-alpha"; do
  # shellcheck disable=SC2086
  go run ./scripts/crd-tools $t --dir apis/config/crd/ >/dev/null 2>&1
done
published=0
for file in apis/config/crd/*.yaml; do
  base="$(basename "${file%.yaml}")"; domain="${base%%_*}"; resource="${base#*_}"
  { echo "# Generated by dev/tasks/generate-crds.  DO NOT EDIT."; echo ""; cat "$file"; } \
    > "config/crds/resources/apiextensions.k8s.io_v1_customresourcedefinition_${resource}.${domain}.yaml"
  published=$((published+1))
done
echo "   published ${published} CRDs"

echo "== 5/6  re-seeding the judgement queue  <-- the step that gets forgotten"
go run ./scripts/queue-hints

echo "== 6/6  checking every +kcc:guess has a queue entry"
python3 hack/tools/greenfield/check_guess_entries.py || {
  echo "   ^ markers without an entry. Anything the generator marks as a guess"
  echo "     needs a human, so it belongs in needs_judgement_call.txt."
}

echo
echo "Now measure. Count undefined fields, not failing packages: a package fails"
echo "whole on one type mismatch, so it moves far slower than real progress."
echo "  go build ./apis/... 2>&1 | grep -oP '\\.(Spec|ObservedState)\\.\\w+ undefined' | sort -u | wc -l"
